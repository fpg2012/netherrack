# 只放密钥和部署相关的覆盖项；其余配置见 config.toml
# 复制成 .env 后填写：
#   cp .env.example .env
#
# 数据库连接串（含密码，所以不放 config.toml）
DATABASE_URL=postgresql+asyncpg://flarum:flarum@localhost:5432/flarum

# 必填，至少 32 字符；生成方式：
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# 可选：指向另一份 TOML（生产环境常用，例如 /etc/flarum-web/config.toml）
# CONFIG_FILE=/etc/flarum-web/config.toml
