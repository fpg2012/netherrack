# 复制成 .env 后按需修改
DATABASE_URL=postgresql+asyncpg://flarum:flarum@localhost:5432/flarum
# 必须自己生成，至少 32 字符；缺失时后端拒绝启动
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
# dev | production。production 会强制校验 COOKIE_SECURE 和 CORS_ORIGINS
ENV=dev
# 打开后 /api/docs 可用（生产环境保持 false）
DEBUG=false
# 走 HTTPS 时必须 true（生产环境强制）
COOKIE_SECURE=false
# 部署在 nginx 等反向代理后面时打开，限流才会按真实客户端 IP 计数
TRUST_PROXY=false
CORS_ORIGINS=["http://localhost:5173"]
ASSETS_DIR=../data/public/assets
LEGACY_DUMP=../data/flarum-2026-10-23.sql.gz
